# ============================================================================
# DocBrain — пример переменных окружения.
# Скопировать в .env и заполнить. Реальный .env в git НЕ коммитится.
# ============================================================================

# --- PostgreSQL (отдельный контейнер docbrain-db, образ pgvector/pgvector:pg16) ---
POSTGRES_USER=docbrain
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=docbrain

# Внутри docker-сети backend ходит к БД по имени сервиса docbrain-db:5432.
# Драйвер asyncpg → схема postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://docbrain:change-me-strong-password@docbrain-db:5432/docbrain

# Bind-mount исходников backend → /app в контейнере. Путь должен быть таким,
# каким его видит docker-daemon (т.е. путь на ХОСТЕ). На VPS code-server
# каталог проекта в code-server'е (/home/coder/projects/docbrain) маппится
# на хост-путь /opt/home-codespaces/projects/docbrain. На чистом dev-окружении
# (где docker запускается на той же FS, где правится код) — оставить пустым,
# compose возьмёт fallback ./backend.
BACKEND_HOST_PATH=/opt/home-codespaces/projects/docbrain/backend

# --- OpenRouter (LLM + эмбеддинги). На текущем шаге не используется. ---
# OPENROUTER_API_KEY=sk-or-v1-...
# EMBEDDING_MODEL=openai/text-embedding-3-small
# CHAT_MODEL=anthropic/claude-3.5-sonnet

# --- Telegram (новый бот, отдельный от scan-agent). Подключим позже. ---
# DOCBRAIN_TELEGRAM_BOT_TOKEN=

# --- MinIO (используем существующий инстанс, бакет docbrain-files). Позже. ---
# MINIO_ENDPOINT=s3.nikulshin-dev.ru
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=docbrain-files

# --- JWT для веб-чата. Позже. ---
# JWT_SECRET_KEY=

# --- n8n. Позже. ---
# N8N_ENCRYPTION_KEY=
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=
