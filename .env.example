# ============================================================================
# DocBrain — пример переменных окружения.
# Скопировать в .env и заполнить. Реальный .env в git НЕ коммитится.
# ============================================================================

# --- PostgreSQL (отдельный контейнер docbrain-db, образ pgvector/pgvector:pg16) ---
POSTGRES_USER=docbrain
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=docbrain

# Внутри docker-сети backend ходит к БД по имени сервиса docbrain-db:5432.
# Драйвер asyncpg → схема postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://docbrain:change-me-strong-password@docbrain-db:5432/docbrain

# Bind-mount исходников backend → /app в контейнере. Путь должен быть таким,
# каким его видит docker-daemon (т.е. путь на ХОСТЕ). На VPS code-server
# каталог проекта в code-server'е (/home/coder/projects/docbrain) маппится
# на хост-путь /opt/home-codespaces/projects/docbrain. На чистом dev-окружении
# (где docker запускается на той же FS, где правится код) — оставить пустым,
# compose возьмёт fallback ./backend.
BACKEND_HOST_PATH=/opt/home-codespaces/projects/docbrain/backend

# --- OpenRouter (LLM + эмбеддинги). Используется со спринта 3. ---
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
CHAT_MODEL=anthropic/claude-3.5-sonnet
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT=30.0
# OPENROUTER_RETRIES=2
# EMBEDDING_BATCH_SIZE=96

# --- Логирование (спринт 3). LOG_FORMAT: console | json. LOG_LEVEL: DEBUG | INFO | WARNING. ---
LOG_FORMAT=console
LOG_LEVEL=INFO

# --- RAG (спринт 2). EMBEDDING_PROVIDER: stub | openrouter. ---
# stub — детерминированный hash→vector, без LLM, для тестов и разработки без ключа.
# openrouter — реальные эмбеддинги через OpenRouter (нужен OPENROUTER_API_KEY).
EMBEDDING_PROVIDER=stub
EMBEDDING_DIM=1536
CHUNK_SIZE=800
CHUNK_OVERLAP=100
# Максимальный размер загружаемого файла, в байтах (10 МБ).
MAX_UPLOAD_BYTES=10485760

# --- Telegram (новый бот, отдельный от scan-agent). Подключим позже. ---
# DOCBRAIN_TELEGRAM_BOT_TOKEN=

# --- MinIO (используем существующий инстанс home-codespaces-minio-1). ---
# Внутренний endpoint — для put/head/delete внутри docker-сети.
# Публичный endpoint — для presigned URL, которые видит внешний клиент.
MINIO_ENDPOINT=http://home-codespaces-minio-1:9000
MINIO_PUBLIC_ENDPOINT=https://s3.nikulshin-dev.ru
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=docbrain-files
# MINIO_PRESIGN_TTL_SEC=3600

# --- JWT для веб-чата. Позже. ---
# JWT_SECRET_KEY=

# --- n8n (спринт 4). ---
# Случайная строка для шифрования учётных данных n8n (Google Drive OAuth2 и др.).
# Сгенерировать: openssl rand -hex 24
N8N_ENCRYPTION_KEY=change-me-32-chars-random-string
# API-ключ для защиты POST /api/import/gdrive.
# Если не задан — endpoint доступен без аутентификации (dev mode).
# Сгенерировать: openssl rand -hex 32
DOCBRAIN_API_KEY=
